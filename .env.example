# ============================================================
# Exemplo de variáveis de ambiente — NÃO coloque valores reais aqui
# Copie para .env.local e preencha com seus dados
# ============================================================

# Supabase (projeto)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key

# Supabase público (client-side)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Login do coordenador
COORDENADOR_USER=seu-email
COORDENADOR_PASS=sua-senha

# WhatsApp Business
WHATSAPP_TOKEN=seu-token-da-meta
WHATSAPP_PHONE_ID=seu-phone-id
WHATSAPP_VERIFY_TOKEN=um-texto-secreto-seu

# Email (Gmail SMTP)
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-gmail
